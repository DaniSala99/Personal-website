---
import { getCollection } from 'astro:content';
import CallToAction from '../components/CallToAction.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Skills from '../components/Skills.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('work')).sort((a, b) => a.id.localeCompare(b.id));
---

<BaseLayout
	title="Daniele Sala | Hydrological Risk Modeler"
	description="Flood risk modeling, hydrological forecasting and CSRD-aligned physical risk for engineering firms, insurers and municipalities across Europe."
>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<Hero
					title="Daniele Sala"
					tagline="Hydrological Risk Modeler · Python · Fortran · GIS"
					align="start"
				>
					<p class="hero-cta">
						I Help Insurers, Utilities &amp; Municipalities Quantify Water-Related Risk Before It
						Becomes a Crisis
					</p>
					<p class="hero-intro">
						In September 2025, the Seveso and Bevera rivers overflowed across Northern Lombardy. I
						was on the operational team running the hydrological alerts, post-event impact assessment
						and institutional reporting that fed directly into Regione Lombardia's emergency
						declarations. That kind of work, where hydrological models meet real consequences for
						real cities, is exactly what I do as a freelancer too.
					</p>
				</Hero>
			</header>

			<Skills />
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			<section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Case Studies</h3>
					<p>
						Flood risk, hydrological modeling, climate analytics, applied to real catchments and
						real clients.
					</p>
				</header>

				<div class="gallery">
					<Grid variant="offset">
						{
							projects.map((project) => (
								<li>
									<PortfolioPreview project={project} />
								</li>
							))
						}
					</Grid>
				</div>

				<div class="cta">
					<CallToAction href="/work/">
						All Case Studies
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		padding-block: 2rem;
	}

	.hero-cta {
		margin-top: 1rem;
		font-size: var(--text-lg);
		font-family: var(--font-brand);
		font-weight: 600;
		color: var(--accent-regular);
		max-width: 45ch;
		line-height: 1.3;
	}

	.hero-intro {
		margin-top: 1rem;
		font-size: var(--text-md);
		color: var(--gray-300);
		max-width: 55ch;
		line-height: 1.7;
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}
</style>
