---
import { getCollection } from 'astro:content';
import CallToAction from '../components/CallToAction.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Skills from '../components/Skills.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const [about] = await getCollection('about');
const featuredProjects = (await getCollection('projects')).sort((a, b) => a.id.localeCompare(b.id));
---

<BaseLayout
	title={`${about.data.name} | ${about.data.tagline}`}
	description={`Personal website of ${about.data.name}. ${about.data.tagline}. Based in ${about.data.location}.`}
>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<div class="hero-content">
					<Hero
						title={about.data.name}
						tagline={about.data.tagline}
						align="start"
					>
					<div class="hero-links">
						<a href="/work/" class="hero-btn primary">
							View Projects
							<Icon icon="arrow-right" size="1em" />
						</a>
						{about.data.email && (
							<a href={`mailto:${about.data.email}`} class="hero-btn secondary">
								Get in Touch
								<Icon icon="paper-plane-tilt" size="1em" />
							</a>
						)}
					</div>
					</Hero>
				</div>
				{about.data.avatar && (
					<div class="hero-portrait">
						<img
							src={about.data.avatar}
							alt={`Portrait of ${about.data.name}`}
							width="600"
							height="750"
						/>
					</div>
				)}
			</header>

			<Skills />
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			<section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Projects</h3>
					<p>
						Research and professional case studies in hydrology, climate risk and environmental engineering.
					</p>
				</header>

				<div class="gallery">
					<Grid variant="offset">
						{
							featuredProjects.map((project) => (
								<li>
									<PortfolioPreview project={project} />
								</li>
							))
						}
					</Grid>
				</div>

				<div class="cta">
					<CallToAction href="/work/">
						All Projects
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		padding-block: 2rem;
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	.hero-portrait {
		justify-self: center;
		max-width: 320px;
		width: 100%;
	}

	.hero-portrait img {
		width: 100%;
		height: auto;
		border-radius: 1rem;
		display: block;
		box-shadow:
			0 10px 30px -10px rgba(0, 0, 0, 0.4),
			0 0 0 1px rgba(255, 255, 255, 0.05);
		object-fit: cover;
		aspect-ratio: 4 / 5;
	}

	.hero-links {
		margin-top: 1.5rem;
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.hero-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.55em 1.4em;
		border-radius: 999rem;
		font-size: var(--text-md);
		font-family: var(--font-brand);
		font-weight: 500;
		text-decoration: none;
		transition: box-shadow var(--theme-transition), opacity var(--theme-transition);
	}

	.hero-btn.primary {
		background: var(--gradient-accent-orange);
		color: var(--accent-text-over);
		box-shadow: var(--shadow-md);
	}

	.hero-btn.primary:hover {
		opacity: 0.9;
	}

	.hero-btn.secondary {
		border: 1px solid var(--gray-700);
		color: var(--gray-200);
		background: var(--gray-999_40);
	}

	.hero-btn.secondary:hover {
		border-color: var(--accent-regular);
		color: var(--accent-regular);
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.hero {
			grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
			gap: 4rem;
		}

		.hero-portrait {
			justify-self: end;
			max-width: 420px;
		}

		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}
</style>
