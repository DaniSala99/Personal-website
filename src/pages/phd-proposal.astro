---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const skills = {
	'Modelling & computing': ['Python', 'R', 'MATLAB', 'Fortran', 'SQL', 'QGIS'],
	'Hydrological tools': ['FEST', 'HEC-RAS', 'ICON / ECMWF-IFS', 'Remote Sensing', 'UAV / drone imagery'],
	'Languages': ['Italian (Native)', 'English (C1)', 'Spanish (B2)'],
};
---

<BaseLayout
	title="Daniele Sala | Interview Presentation"
	description="PhD interview presentation for ForFuS / LIST. Background, education, professional experience, and relevant academic work in process-based hydrological modelling and statistical time-series analysis."
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-10">
			<Hero
				title="Daniele Sala"
				tagline="Environmental Engineer · Process-Based Hydrological Modelling · Multi-Source Data Integration"
				align="start"
			/>

			<div class="page-content">

				<!-- ── SECTION 1: ABOUT ME ── -->
				<section class="page-section">
					<h2 class="section-heading">About Me</h2>

					<!-- Education -->
					<div class="subsection">
						<h3 class="subsection-heading">Education</h3>
						<div class="timeline">

							<div class="tl-item">
								<div class="tl-dot"></div>
								<div class="tl-body">
									<div class="tl-row">
										<span class="tl-degree">M.Sc. Environmental and Land Planning Engineering</span>
										<span class="tl-grade">106 / 110</span>
									</div>
									<p class="tl-inst">Politecnico di Milano · 2021–2024</p>
									<p class="tl-desc">
										Weighted average 27.31 / 30. Relevant coursework: Hydrogeological Risk (30/30) ·
										Remote Sensing (30/30) · Statistical Models and Stochastic Processes (29/30) ·
										Ecosystems Conservation and Management (29/30).
									</p>
								</div>
							</div>

							<div class="tl-item">
								<div class="tl-dot"></div>
								<div class="tl-body">
									<div class="tl-row">
										<span class="tl-degree">Erasmus Exchange Semester</span>
									</div>
									<p class="tl-inst">Universitat Politècnica de València (UPV), Spain · 2022–2023</p>
									<p class="tl-desc">
										Specialisation in Water Quality, Pollution Transport in Natural Environments, and
										Wastewater Treatment Management.
									</p>
								</div>
							</div>

							<div class="tl-item">
								<div class="tl-dot"></div>
								<div class="tl-body">
									<div class="tl-row">
										<span class="tl-degree">B.Sc. Environmental Engineering</span>
									</div>
									<p class="tl-inst">Politecnico di Milano · 2018–2021</p>
									<p class="tl-desc">
										Foundation in environmental engineering, fluid mechanics, hydrology, and environmental
										systems.
									</p>
								</div>
							</div>

						</div>
					</div>

					<!-- Professional Experience -->
					<div class="subsection">
						<h3 class="subsection-heading">Professional Experience</h3>
						<div class="exp-list">

							<div class="exp-item">
								<div class="exp-header">
									<div class="exp-title-block">
										<span class="exp-role">Natural Risk Assessment Specialist</span>
										<span class="exp-company">Progesi S.p.A. · Milan</span>
									</div>
									<span class="exp-period">2025 – Present</span>
								</div>
								<ul class="exp-bullets">
									<li>
										Develop and maintain integrated environmental monitoring systems processing
										multi-source data from ground stations, satellite platforms, and NWP models
										(ICON-I2, ECMWF-IFS) for regional-scale natural hazard management and risk
										quantification.
									</li>
									<li>
										Calibrate regional hydrological forecasting against ground-station and satellite
										observations over the Po Plain and Alpine foothills; collaborate with university
										research groups and PhD teams on applied hydrometeorological and climate modelling
										projects.
									</li>
									<li>
										<strong>September 2025 — Seveso &amp; Bevera flood event:</strong> led
										end-to-end flood risk management from hydrological alerting and real-time
										monitoring to post-event impact assessment and institutional reporting, supporting
										Regione Lombardia in emergency state declarations and damage compensation claims.
									</li>
								</ul>
							</div>

							<div class="exp-item">
								<div class="exp-header">
									<div class="exp-title-block">
										<span class="exp-role">Climate Data Analyst</span>
										<span class="exp-company">Enel S.p.A. · Milan</span>
									</div>
									<span class="exp-period">2024</span>
								</div>
								<ul class="exp-bullets">
									<li>
										Analysed climate datasets to assess physical and transition risks for a global
										energy infrastructure portfolio; developed Python and R automation for climate data
										ingestion and CSRD / ESRS E1 sustainability benchmarking.
									</li>
								</ul>
							</div>

						</div>
					</div>

					<!-- Skills -->
