---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
	{
		title: 'Three Gorges Dam: Educational Multimedia Project',
		year: '2018',
		type: 'High School Thesis · Esame di Maturità',
		description:
			'An interactive web presentation on the world\'s largest hydroelectric dam, covering technical specifications (22.5 GW installed capacity, 32 Francis turbines), environmental impact, 1.4M people displaced, and geopolitical implications of China\'s water infrastructure policy. Interdisciplinary approach across geography, hydraulic engineering and environmental science.',
		tools: ['HTML5', 'CSS3', 'Bootstrap 3', 'jQuery', 'Swiper.js', 'Parallax.js'],
		repo: 'https://github.com/DaniSala99/Three-Gorges-Dam---Educational-Multimedia-Project',
	},
];
---

<BaseLayout
	title="Projects | Daniele Sala"
	description="Lab work, educational projects and one-off builds outside the main professional case studies."
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-12">
			<Hero
				title="Lab &amp; Side Projects"
				tagline="Educational work, experiments and one-off builds outside the professional case studies."
				align="start"
			/>

			<ul class="project-list">
				{
					projects.map((p) => (
						<li class="project-card">
							<div class="card-top">
								<div class="meta">
									<span class="type-badge">{p.type}</span>
									<span class="year">{p.year}</span>
								</div>
								<h2 class="title">{p.title}</h2>
								<p class="description">{p.description}</p>
							</div>

							<div class="card-bottom">
								<ul class="tools" aria-label="Technologies">
									{p.tools.map((tool) => (
										<li>{tool}</li>
									))}
								</ul>
								<a
									class="repo-link"
									href={p.repo}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`GitHub repository for ${p.title}`}
								>
									<Icon icon="github-logo" size="1.1em" />
									View on GitHub
									<Icon icon="arrow-right" size="1em" />
								</a>
							</div>
						</li>
					))
				}
			</ul>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.project-list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.project-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 2rem;
		padding: 2rem;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		box-shadow: var(--shadow-sm);
	}

	.card-top {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.type-badge {
		font-size: var(--text-sm);
		padding: 0.2rem 0.75rem;
		border: 1px solid var(--accent-regular);
		border-radius: 999rem;
		color: var(--accent-regular);
		font-family: var(--font-brand);
		font-weight: 500;
	}

	.year {
		font-size: var(--text-sm);
		color: var(--gray-400);
	}

	.title {
		font-size: var(--text-xl);
		color: var(--gray-0);
		line-height: 1.3;
	}

	.description {
		font-size: var(--text-base);
		color: var(--gray-300);
		line-height: 1.7;
		max-width: 70ch;
	}

	.card-bottom {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.tools {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		list-style: none;
		padding: 0;
	}

	.tools li {
		font-size: var(--text-sm);
		padding: 0.125rem 0.625rem;
		background: var(--accent-overlay);
		color: var(--accent-dark);
		border-radius: 999rem;
	}

	.repo-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--text-base);
		font-family: var(--font-brand);
		font-weight: 500;
		color: var(--gray-200);
		text-decoration: none;
		transition: color var(--theme-transition);
		width: fit-content;
	}

	.repo-link:hover,
	.repo-link:focus {
		color: var(--accent-regular);
	}

	@media (min-width: 50em) {
		.project-card {
			flex-direction: row;
			align-items: flex-end;
			padding: 2.5rem;
			border-radius: 1.5rem;
		}

		.card-top {
			flex: 1;
		}

		.card-bottom {
			flex-shrink: 0;
			align-items: flex-end;
		}

		.title {
			font-size: var(--text-2xl);
		}
	}
</style>
