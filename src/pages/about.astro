---
import { getCollection, render } from 'astro:content';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const [about] = await getCollection('about');
const { Content: Bio } = await render(about);

const workEntries = (await getCollection('workExperience')).sort((a, b) => a.id.localeCompare(b.id));
const renderedWork = await Promise.all(workEntries.map((e) => render(e)));

const eduEntries = (await getCollection('education')).sort((a, b) => a.id.localeCompare(b.id));
---

<BaseLayout
	title={`About | ${about.data.name}`}
	description={`${about.data.tagline}. Based in ${about.data.location}.`}
>
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline={about.data.tagline}
			/>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<Bio />
				</div>
			</section>

			<section>
				<h2 class="section-title">Experience</h2>
				<div class="content">
					{workEntries.map((entry, i) => {
						const { Content } = renderedWork[i];
						return (
							<div class="role">
								<h3>{entry.data.title}, {entry.data.company}</h3>
								<p class="role-period">
									{entry.data.start}–{entry.data.end ?? 'Present'}
								</p>
								<Content />
								{entry.data.skills && entry.data.skills.length > 0 && (
									<p class="role-skills">
										<strong>Skills:</strong> {entry.data.skills.join(' · ')}
									</p>
								)}
							</div>
						);
					})}
				</div>
			</section>

			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					{eduEntries.map((entry) => (
						<div class="role">
							<h3>{entry.data.degree}</h3>
							<p class="role-period">
								{entry.data.institution}
								{entry.data.location ? `, ${entry.data.location}` : ''}
								{' · '}
								{entry.data.start}–{entry.data.end ?? 'Ongoing'}
								{entry.data.grade ? ` · ${entry.data.grade}` : ''}
							</p>
							{entry.data.description && <p>{entry.data.description}</p>}
						</div>
					))}
				</div>
			</section>

			{(about.data.certifications?.length || about.data.languages?.length) && (
				<section>
					<h2 class="section-title">Certifications &amp; Languages</h2>
					<div class="content">
						{about.data.certifications?.map((c) => <p>{c}</p>)}
						{about.data.languages && (
							<p>{about.data.languages.join(' · ')}</p>
						)}
					</div>
				</section>
			)}
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.role {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		margin-top: 1.5rem;
	}

	.role:first-child {
		margin-top: 0;
	}

	.content :global(h3) {
		font-size: var(--text-lg);
		color: var(--gray-0);
	}

	.role-period {
		font-size: var(--text-sm);
		color: var(--gray-400);
	}

	.role-skills {
		font-size: var(--text-sm);
		color: var(--gray-400);
		margin-top: 0.25rem;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
