---
import { getCollection } from 'astro:content';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const allProjects = (await getCollection('projects')).sort((a, b) => a.id.localeCompare(b.id));
---

<BaseLayout
	title="Projects"
	description="Research and professional case studies in hydrology, flood risk modeling and climate risk analytics."
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Projects"
				tagline="Research and professional case studies spanning hydrology, flood risk modeling, climate analytics and multi-objective optimization."
				align="start"
			/>
			<Grid variant="offset">
				{
					allProjects.map((project) => (
						<li>
							<PortfolioPreview project={project} />
						</li>
					))
				}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
