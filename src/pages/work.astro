---
import { getCollection } from 'astro:content';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('work')).sort((a, b) => a.id.localeCompare(b.id));
---

<BaseLayout
	title="Research Projects | Daniele Sala"
	description="Four research projects spanning flood risk, hydrological modelling, statistical climate analysis and multi-objective reservoir optimisation: Po River, Olona, paleoclimate, Red River."
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Research Projects"
				tagline="Four projects spanning process-based hydrological modelling, flood risk, statistical climate analysis and multi-objective reservoir optimisation."
				align="start"
			/>
			<Grid variant="offset">
				{
					projects.map((project) => (
						<li>
							<PortfolioPreview project={project} />
						</li>
					))
				}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
