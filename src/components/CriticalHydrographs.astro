---
---

<div class="hydrograph-container">
	<figure class="hydrograph-figure">
		<div class="canvas-wrap">
			<canvas id="chart-lozza"></canvas>
		</div>
		<figcaption>Sezione Lozza — critical discharge envelope (T = 50 / 100 / 200 / 500 anni)</figcaption>
	</figure>
	<figure class="hydrograph-figure">
		<div class="canvas-wrap">
			<canvas id="chart-ol7a"></canvas>
		</div>
		<figcaption>Sezione Ol7a — critical discharge envelope (T = 50 / 100 / 200 / 500 anni)</figcaption>
	</figure>
</div>

<script>
// Peak points (tc/2, Qp) for each return period, sorted by tc/2 ascending,
// prefixed by the origin — this traces the envelope of critical discharges.
const LOZZA_ENV = [
	{ x: 0,    y: 0      },
	{ x: 42.5, y: 789.49 },  // T = 500
	{ x: 45,   y: 588.74 },  // T = 200
	{ x: 47.5, y: 465.00 },  // T = 100
	{ x: 52.5, y: 363.63 },  // T = 50
];

const OL7A_ENV = [
	{ x: 0,    y: 0      },
	{ x: 12.5, y: 165.94 },  // T = 500
	{ x: 15,   y: 129.34 },  // T = 200 (max at tc/2 = 15 min)
	{ x: 17.5, y: 86.44  },  // T = 50
];

function makeDataset(data) {
	return [{
		label: 'Critical discharge envelope',
		data,
		borderColor: '#e07b3b',
		backgroundColor: 'rgba(224, 123, 59, 0.08)',
		showLine: true,
		fill: false,
		tension: 0.35,
		pointRadius: 4,
		pointHoverRadius: 6,
		borderWidth: 2.5,
	}];
}

function buildOptions(yMax) {
	const isDark = document.documentElement.classList.contains('theme-dark');
	const grid  = isDark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.07)';
	const tick  = isDark ? '#c3cadb' : '#505d84';

	return {
		responsive: true,
		maintainAspectRatio: true,
		aspectRatio: 1.6,
		plugins: {
			legend: {
				position: 'top',
				labels: { color: tick, boxWidth: 16, padding: 14, font: { size: 13 } },
			},
			tooltip: {
				mode: 'nearest',
				intersect: false,
				callbacks: {
					label: (ctx) =>
						`t = ${ctx.parsed.x} min, Q = ${ctx.parsed.y.toFixed(2)} m³/s`,
				},
			},
		},
		scales: {
			x: {
				type: 'linear',
				title: { display: true, text: 'Tempo [min]', color: tick, font: { size: 13 } },
				min: 0,
				grid: { color: grid },
				ticks: { color: tick },
			},
			y: {
				title: { display: true, text: 'Portata [m³/s]', color: tick, font: { size: 13 } },
				min: 0,
				suggestedMax: yMax,
				grid: { color: grid },
				ticks: { color: tick },
			},
		},
	};
}

const s = document.createElement('script');
s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js';
s.onload = () => {
	new Chart(document.getElementById('chart-lozza'), {
		type: 'scatter',
		data: { datasets: makeDataset(LOZZA_ENV) },
		options: buildOptions(900),
	});
	new Chart(document.getElementById('chart-ol7a'), {
		type: 'scatter',
		data: { datasets: makeDataset(OL7A_ENV) },
		options: buildOptions(200),
	});
};
document.head.appendChild(s);
</script>

<style>
.hydrograph-container {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 2rem;
	margin: 2rem 0;
}

.hydrograph-figure {
	margin: 0;
	padding: 1.25rem 1.25rem 0.75rem;
	background: var(--gray-999_40);
	border: 1px solid var(--gray-800);
	border-radius: 0.75rem;
}

.canvas-wrap {
	position: relative;
	width: 100%;
}

.hydrograph-figure figcaption {
	font-size: var(--text-sm);
	color: var(--gray-400);
	font-style: italic;
	text-align: center;
	padding: 0.5rem 0 0.25rem;
}

@media (max-width: 50em) {
	.hydrograph-container {
		grid-template-columns: 1fr;
	}
}
</style>
